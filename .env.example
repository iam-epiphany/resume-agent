# ResumeMind runtime configuration（个人简历问答 Agent）
# 复制本文件为 .env 并填写真实值：cp .env.example .env
# 注意：.env 含密钥，切勿提交到 git / 随包发送；本模板为入库脱敏版。

# ---- LLM（OpenAI 兼容 Chat Completions，默认 DeepSeek）----
# LLM_BASE_URL 为 API 根地址，不要包含 /chat/completions
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_RESPONSE_FORMAT=json_object
LLM_STREAM=true
# DeepSeek 推理模型（v4-flash）默认思考：流式响应先输出 reasoning_content
# （content 为 null），思考长时被误判为空响应/超时。代码已对 DeepSeek 显式禁用
# 思考（include_thinking=false → thinking:disabled），保持 false 即可。
LLM_INCLUDE_THINKING=false
DEEPSEEK_API_KEY=
RESUME_BUILD_ID=resumemind-agent-v1

# ---- 管理员认证（前后台分离）----
# ADMIN_PASSWORD 必填（security.py fail-closed，缺失拒绝启动）；
# AUTH_REQUIRED=true 时文档/管理接口需登录 token（生产必须 true）。
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
ADMIN_TOKEN_EXPIRY_HOURS=12
AUTH_REQUIRED=true

# ---- 限流（防恶意刷 LLM token）----
RATE_LIMIT_ENABLED=true
# 问答每 IP 每分钟次数（0 = 不限制，仅保留全局并发）
QA_IP_RATE_LIMIT_PER_MINUTE=30
# 每 IP 累计可提问总数上限（写 qa_logs 即消耗 1 次，不按天）；
# 用尽后该 IP 提问返回 429，调大此值或清理 qa_logs 恢复。管理员请求不受限。
QA_IP_MAX_QUESTIONS=20
# 问题长度上限（字符数），超限返回 400
QA_MAX_QUESTION_CHARS=500
# 全局同时执行问答的最大并发（2C4G 保守稳定档建议 2）
QA_GLOBAL_CONCURRENCY=2
# 问答并行 worker（2C4G 档 2：2 人同时提问各自并行，3 人排队变慢；1 = 单 worker 串行）
QA_TASK_WORKERS=2
LOGIN_RATE_LIMIT_PER_MINUTE=10
# 部署在可信反向代理（Cloudflare Tunnel）后必须 true，按 X-Forwarded-For 取真实访客 IP
RATE_LIMIT_TRUST_PROXY=true

# ---- 访客问答访问码闸 ----
# 简历中附带的访问码，面试官输入一次签发短期 JWT 存 httpOnly cookie；
# 无码访客只能看到页面、不能提问（QA_ACCESS_CODE 为空 = 关闭闸门）。
# 访问码必须为 6 位数字+大写英文字母（如 A7K2M9），格式不合法启动即报错；
# 生成命令：python -c "import secrets,string;print(''.join(secrets.choice(string.digits+string.ascii_uppercase) for _ in range(6)))"
# 输错阶梯锁定：同一 IP 连续错 3 次锁 1 分钟，解锁后再错升一档（1→5→10→30→60 分钟封顶）
QA_ACCESS_CODE=
QA_ACCESS_TOKEN_TTL_HOURS=24
# HTTPS 部署（Cloudflare Tunnel）时必须 true，给访问码 cookie 加 Secure 标记；
# 仅本地 HTTP 开发（无隧道）时置 false
COOKIE_SECURE=true

# ---- 全局每日提问预算（跨 IP 保险丝，防换 IP 刷爆 DeepSeek 额度）----
QA_GLOBAL_DAILY_LIMIT=300
QA_BUDGET_WARNING_REMAINING=30
QA_BUDGET_WARNING_RATIO=0.15

# ---- 模型与推理（2C4G CPU 配置）----
# ---- 人物模型 ----
# 默认人物姓名（部署者自己的名字）：留空 = 不注入姓名，提示词/文案用中性"我/求职者"；
# 也可在后台「人物工坊」创建/提取人物档案。系统不内置任何人的姓名。
DEFAULT_PERSONA_NAME=

# 模型已本地化（data/models/），默认离线运行
RESUME_OFFLINE_MODE=true
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
MODEL_DEVICE=cpu
RESUME_PERFORMANCE_MODE=cpu_low_resource
MODEL_BACKEND=pytorch
# 面试场景建议 blocking：容器在模型预热完成后才接受流量，避免首问变慢。
MODEL_WARMUP_POLICY=blocking
RERANK_BATCH_SIZE=2
RERANK_INPUT_MODE=compact
# FlagEmbedding 1.4.0 在 768/1024 长度下有编码边界 bug（IndexError），512 稳定
RERANK_MAX_LENGTH=512
RERANK_CANDIDATE_LIMIT=12
RERANK_TOP_K=12
TORCH_NUM_THREADS=2
TORCH_NUM_INTEROP_THREADS=1
# 仅当 reranker ONNX parity 报告通过后，才改为 MODEL_BACKEND=onnx。
RERANKER_ONNX_MODEL_PATH=/app/data/models/bge-reranker-base-onnx-int8/model.onnx
RERANK_ONNX_INTRA_OP_THREADS=2
RERANK_ONNX_INTER_OP_THREADS=1
# Docker Compose 资源上限：2C4G 档不应删掉，避免 qdrant 挤占模型内存。
RESUME_APP_MEM_LIMIT=2800m
RESUME_APP_CPU_LIMIT=2.0
RESUME_QDRANT_MEM_LIMIT=384m
RESUME_QDRANT_CPU_LIMIT=0.5
EMBEDDING_BATCH_SIZE=4
EMBEDDING_MAX_BATCH_SIZE=8
# 模型栈（2C4G 轻量档）：bge-small-zh-v1.5 embedding（512 维）+ bge-reranker-base。
# 回退 bge-base-zh-v1.5（768 维）需同时改下面三项并重建索引。
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL_PATH=/app/data/models/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
INDEX_VERSION=bge-small-zh-dense-v6-resume

# ---- Qdrant ----
QDRANT_COLLECTION=resumemind_chunks
QDRANT_AUTO_CREATE_COLLECTION=true

# ---- LLM 超时与模型选择（意图/规划/生成可独立指向更快小模型）----
INTENT_ROUTER_MODEL=deepseek-v4-flash
INTENT_ROUTER_TIMEOUT_SECONDS=8
QUERY_PLANNER_MODEL=deepseek-v4-flash
QUERY_PLANNER_TIMEOUT_SECONDS=25
ANSWER_GENERATION_MODEL=deepseek-v4-flash
ANSWER_GENERATION_TIMEOUT_SECONDS=30

# ---- 检索与置信度分级（宽松推理架构）----
# 主检索门槛：低于门槛的弱证据由兜底链降阈补选，最终由 LLM 自评决定是否加推测标注
RERANK_PROMPT_THRESHOLD=0.20
MIN_CORE_RERANK_SCORE=0.20
MIN_LEXICAL_SCORE=2.0
MIN_LEXICAL_RERANK_SCORE=0.05
# 简历问答问题宽泛，关闭词汇覆盖率门禁、以 rerank 语义排序为主
MIN_EVIDENCE_COVERAGE=0

# ---- fast path（普通独立问题减少 LLM 调用；默认开启，可关闭回退完整链路）----
INTENT_FAST_PATH_ENABLED=true
PLANNER_FAST_PATH_ENABLED=true
