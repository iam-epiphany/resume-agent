# ResumeMind 4C8G stable interview profile (recommended for a 2-3 month window).
# It retains the validated PyTorch BGE reranker; do not switch to the unqualified INT8 artifact.
MODEL_DEVICE=cpu
RESUME_PERFORMANCE_MODE=cpu_balanced
MODEL_BACKEND=pytorch
MODEL_WARMUP_POLICY=blocking
RERANK_BATCH_SIZE=4
RERANK_MAX_LENGTH=512
RERANK_INPUT_MODE=compact
RERANK_CANDIDATE_LIMIT=12
RERANK_TOP_K=12
TORCH_NUM_THREADS=4
TORCH_NUM_INTEROP_THREADS=1
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_BATCH_SIZE=8
# 问答并行 worker：4C8G 档可到 3（3 人同时提问并行）
QA_TASK_WORKERS=3
# 模型栈（2C4G 轻量档）：bge-small-zh-v1.5 embedding（512 维）+ bge-reranker-base
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL_PATH=/app/data/models/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
INDEX_VERSION=bge-small-zh-dense-v6-resume
QA_GLOBAL_CONCURRENCY=2
RESUME_APP_MEM_LIMIT=5600m
RESUME_APP_CPU_LIMIT=4.0
RESUME_QDRANT_MEM_LIMIT=768m
RESUME_QDRANT_CPU_LIMIT=1.0
