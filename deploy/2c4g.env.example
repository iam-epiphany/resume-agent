# ResumeMind 2C4G conservative profile (one visitor asks at a time).
# Copy the entries into the server's .env; keep secrets in that same .env only.
MODEL_DEVICE=cpu
RESUME_PERFORMANCE_MODE=cpu_low_resource
MODEL_BACKEND=pytorch
MODEL_WARMUP_POLICY=blocking
RERANK_BATCH_SIZE=2
RERANK_MAX_LENGTH=512
RERANK_INPUT_MODE=compact
RERANK_CANDIDATE_LIMIT=12
RERANK_TOP_K=12
TORCH_NUM_THREADS=2
TORCH_NUM_INTEROP_THREADS=1
EMBEDDING_BATCH_SIZE=4
EMBEDDING_MAX_BATCH_SIZE=8
# 问答并行 worker：2 人同时提问各自并行（稳定），3 人排队变慢（勉强）
QA_TASK_WORKERS=2
# 模型栈（2C4G 轻量档）：bge-small-zh-v1.5 embedding（512 维）+ bge-reranker-base
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL_PATH=/app/data/models/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
INDEX_VERSION=bge-small-zh-dense-v6-resume
QA_GLOBAL_CONCURRENCY=2
RESUME_APP_MEM_LIMIT=2800m
RESUME_APP_CPU_LIMIT=2.0
RESUME_QDRANT_MEM_LIMIT=384m
RESUME_QDRANT_CPU_LIMIT=0.5
